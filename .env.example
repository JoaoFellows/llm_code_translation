# Provedor de chat. Valores: openai | openrouter | deepseek | gemini | ollama
# Os runners atuais ainda não leem esta variável: run_classeval tenta openai e,
# sem crédito, cai para gemini; run_classeval_batch usa gemini.
CLASS_TRANSLATION_PROVIDER=openai

# Preencha só a chave do provedor escolhido. As outras podem ficar vazias.
# openai     -> https://api.openai.com/v1, modelo gpt-4.1-mini
OPENAI_API_KEY=sk-apx055ac8a8075b0c719c4712b674b5a0708ee7adc9dd491d2

# openrouter -> https://openrouter.ai/api/v1, modelo openai/gpt-4.1-mini
OPENROUTER_API_KEY=

# deepseek   -> https://api.deepseek.com, modelo deepseek-chat
DEEPSEEK_API_KEY=

# gemini     -> endpoint compatível com a API OpenAI, modelo gemini-3.5-flash-lite
GEMINI_API_KEY=

# ollama     -> http://127.0.0.1:11434/v1, modelo qwen2.5-coder
# Pode ficar vazia: o cliente usa a chave literal "ollama".
OLLAMA_API_KEY=

# Raiz do clone do ClassEval-T. Lida por run_classeval e run_classeval_batch.
# Se vazia, os dois usam C:\ClassEval-T.
CLASSEVAL_T_PATH=C:\ClassEval-T
